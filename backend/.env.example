APP_ENV=development
DATABASE_URL=postgresql+psycopg2://tibiahub_app:replace_with_a_secret@127.0.0.1:5432/tibiahub
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000

SECRET_KEY=replace_with_a_long_random_secret
API_HOST=127.0.0.1
API_PORT=8001
RAFFLE_SCHEDULER_ENABLED=false
RAFFLE_SCHEDULER_WORKER_ID=raffle-scheduler-1

# PostgreSQL integration tests must use a clearly test-only database name.
TEST_DATABASE_URL=postgresql+psycopg2://tibiahub_test_app:replace_with_a_secret@127.0.0.1:5432/tibiahub_test

# Operations scripts. POSTGRES_ADMIN_URL is supplied only for provision/reset.
TIBIAHUB_DATABASE_NAME=tibiahub
TIBIAHUB_DATABASE_ROLE=tibiahub_app
TIBIAHUB_DATABASE_HOST=127.0.0.1
TIBIAHUB_DATABASE_PORT=5432
TIBIAHUB_BACKUP_DIR=/var/backups/tibiahub
