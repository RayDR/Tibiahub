# Development/test example only. Production reads /forge/tibiahub-secrets/runtime.env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://tibiahub_app@127.0.0.1:5432/tibiahub
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000

SECRET_KEY=development-only-value
API_HOST=127.0.0.1
API_PORT=8001
MEDIA_STORAGE_ROOT=/forge/tibiahub-storage/media
RAFFLE_SCHEDULER_ENABLED=false
RAFFLE_SCHEDULER_WORKER_ID=raffle-scheduler-1

# Read-only conversational assistant. Keep disabled until OPENAI_API_KEY is
# supplied through the external runtime secret file; never expose it to Vite.
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=gpt-5-mini
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_TIMEOUT_SECONDS=60
ASSISTANT_MAX_MESSAGE_CHARS=2000
ASSISTANT_MAX_HISTORY_MESSAGES=12
ASSISTANT_MAX_OUTPUT_TOKENS=3000
ASSISTANT_RATE_LIMIT_REQUESTS=20
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=60
OPENAI_API_KEY=

# PostgreSQL integration tests must use a clearly test-only database name.
TEST_DATABASE_URL=postgresql+psycopg2://tibiahub_test_app@127.0.0.1:5432/tibiahub_test

# Non-secret target metadata. Provisioning credentials live outside the repo.
TIBIAHUB_POSTGRES_ADMIN_MODE=credential_file
TIBIAHUB_DATABASE_NAME=tibiahub
TIBIAHUB_DATABASE_ROLE=tibiahub_app
TIBIAHUB_DATABASE_HOST=127.0.0.1
TIBIAHUB_DATABASE_PORT=5432
TIBIAHUB_BACKUP_DIR=/var/backups/tibiahub
